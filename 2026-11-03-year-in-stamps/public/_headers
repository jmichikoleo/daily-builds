# Netlify headers (read from the published folder, so they also apply to Netlify Drop uploads).

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; media-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000

# Fingerprinted build assets never change.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# The destination catalog changes only when it is regenerated.
/data/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
