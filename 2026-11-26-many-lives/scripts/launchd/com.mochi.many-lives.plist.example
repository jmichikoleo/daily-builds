<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.mochi.many-lives</string>
  <key>WorkingDirectory</key><string>/Users/YOU/Desktop/mochis-project/many-lives/backend</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/YOU/Desktop/mochis-project/many-lives/scripts/serve.mjs</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>ML_DATA_DIR</key><string>/Users/YOU/Library/Application Support/many-lives</string>
    <key>ML_PORT</key><string>4680</string>
    <key>ML_OWNER_LOGIN</key><string>YOUR_TAILSCALE_LOGIN</string>
    <key>ML_SPOTIFY_REDIRECT</key><string>http://127.0.0.1:4680/api/spotify/callback</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>/Users/YOU/Library/Logs/many-lives/server.log</string>
  <key>StandardErrorPath</key><string>/Users/YOU/Library/Logs/many-lives/server.log</string>
</dict>
</plist>
