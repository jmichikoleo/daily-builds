{
  "name": "jarvis",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "click-to-talk console for claude code and codex",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "esbuild web/app.ts --bundle --format=esm --target=es2022 --outfile=public/app.js",
    "start": "npm run build && node src/server/index.ts",
    "mock": "npm run build && JARVIS_MOCK=1 node src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/*.test.ts'"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.329"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
