# port the node server listens on
PORT=5341
# bind address (use 0.0.0.0 inside docker, 127.0.0.1 behind a local tunnel)
HOST=127.0.0.1
# comma separated list of allowed browser origins for socket.io (leave empty for same origin only)
CORS_ORIGINS=
# trust X-Forwarded-For from a reverse proxy / tunnel (needed for per-ip rate limits)
TRUST_PROXY=1
# minutes an idle room is kept before it is deleted
ROOM_IDLE_MINUTES=60
# hard cap on room age in hours
ROOM_MAX_AGE_HOURS=12
# seconds a disconnected player keeps their seat
RECONNECT_GRACE_SECONDS=90
# seconds before host powers move to someone else while the host is disconnected
HOST_GRACE_SECONDS=25
# maximum concurrent rooms on this server
MAX_ROOMS=300
